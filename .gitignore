# Prerequisites
*.d
*.obj
*.exe
*.pdb
*.ilk
*.suo
*.sln
*.vcxproj
*.vcxproj.user
*.vcxproj.filters

# CMake Build Folders
build/
out/
bin/
cmake-build-debug/
cmake-build-release/
.vs/

# Ignore compiled Vulkan shaders
assets/shaders/*.spv

# Third-party content (models, textures, HDRIs, scenes) is local-test only and must
# never be pushed: licenses (e.g. CC-BY-NC-SA) may forbid redistribution. Assets are
# allowlisted: only engine-authored fixtures, color LUTs, shaders, and manifests are
# tracked. Anything else dropped under assets/ stays local automatically.
/assets/*
!/assets/benchmarks/
!/assets/color/
!/assets/shaders/
!/assets/*.json
!/assets/scenes/
/assets/scenes/*
!/assets/scenes/test_scene.json

# Common third-party content formats anywhere outside the allowlist above
*.hdr
*.exr
*.fbx
*.blend
*.blend1

# Uncompiled vendored samples (kept locally, not tracked; nothing in the build
# references them). ImGuizmo's example tree carries a second copy of Dear ImGui.
/src/vendor/imguizmo/example/
/src/vendor/imguizmo/vcpkg-example/
/src/vendor/imguizmo/Images/
/src/vendor/imgui/examples/**/*.bat

# System
.DS_Store
Thumbs.db
# Claude Code agent worktrees (local only)
/.claude/worktrees/
