#version 450
#include "include/clustered_lighting.glsl"

// M7.10.2: workgroup (light, chunk) counts every gl_NumWorkGroups.y-th
// 64-cluster run of the light's AABB (grid-stride), so a large light spreads
// over many workgroups. cluster_light_bounds evaluated the light and its
// reservation; the per-cluster increments and their overflow checks are
// unchanged.
layout(local_size_x = 64) in;

void main() {
    uint activeIndex = gl_WorkGroupID.x;
    if (activeIndex >= clusterInput.x) return;
    ClusterLightBounds record = clusterLightBounds[activeIndex];
    if ((record.spanFlags.w & IRIDIUM_CLUSTER_BOUNDS_COUNT) == 0u) return;

    uvec3 minimum = record.minimumSlot.xyz;
    uvec3 span = record.spanFlags.xyz;
    uint volume = span.x * span.y * span.z;
    uint plane = span.x * span.y;
    uint stride = 64u * gl_NumWorkGroups.y;
    for (uint linear = gl_WorkGroupID.y * 64u + gl_LocalInvocationID.x;
        linear < volume; linear += stride) {
        if (clusterDiagnostics[IRIDIUM_DIAGNOSTIC_OVERFLOW] != 0u) return;
        uint z = linear / plane;
        uint remainder = linear - z * plane;
        uint y = remainder / span.x;
        uint x = remainder - y * span.x;
        iridiumSaturatingIncrementCount(iridiumClusterIndex(
            minimum + uvec3(x, y, z)));
    }
}
