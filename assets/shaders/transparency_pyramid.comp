#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform GlobalUBO {
    mat4 model;
    mat4 view;
    mat4 proj;
    mat4 inverseView;
    mat4 inverseProjection;
    vec4 cameraPosition;
    vec4 depthRange;
    uvec4 renderInfo;
    vec4 worldUnits;
} ubo;

layout(set = 1, binding = 0) uniform sampler2D sourceColor;
layout(set = 1, binding = 1) uniform sampler2D sourceDepth;
layout(rgba16f, set = 1, binding = 2) uniform writeonly image2D outputColor;
layout(r32f, set = 1, binding = 3) uniform writeonly image2D outputDepth;

layout(push_constant) uniform TransparencyPyramidPush {
    uint outputWidth;
    uint outputHeight;
    uint sourceMip;
    uint initialize;
} push;

#include "include/transparency_transport.glsl"

void main() {
    ivec2 outputPixel = ivec2(gl_GlobalInvocationID.xy);
    if (outputPixel.x >= int(push.outputWidth) ||
        outputPixel.y >= int(push.outputHeight))
        return;

    if (push.initialize != 0u) {
        vec4 color = texelFetch(sourceColor, outputPixel, 0);
        float deviceDepth = texelFetch(sourceDepth, outputPixel, 0).r;
        vec2 uv = (vec2(outputPixel) + 0.5) /
            vec2(push.outputWidth, push.outputHeight);
        vec3 viewPosition = iridiumReconstructViewPosition(
            uv, deviceDepth, ubo.inverseProjection);
        float metricDepth = abs(viewPosition.z) * max(ubo.worldUnits.x, 1.0e-7);
        imageStore(outputColor, outputPixel, color);
        imageStore(outputDepth, outputPixel, vec4(metricDepth));
        return;
    }

    ivec2 sourceSize = textureSize(sourceColor, int(push.sourceMip));
    ivec2 base = outputPixel * 2;
    vec4 colorSum = vec4(0.0);
    float nearestDepth = 3.402823e38;
    float sampleCount = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 sourcePixel = base + ivec2(x, y);
            if (any(greaterThanEqual(sourcePixel, sourceSize)))
                continue;
            colorSum += texelFetch(sourceColor, sourcePixel,
                int(push.sourceMip));
            nearestDepth = min(nearestDepth, texelFetch(sourceDepth,
                sourcePixel, int(push.sourceMip)).r);
            sampleCount += 1.0;
        }
    }
    imageStore(outputColor, outputPixel, colorSum / max(sampleCount, 1.0));
    imageStore(outputDepth, outputPixel, vec4(nearestDepth));
}
