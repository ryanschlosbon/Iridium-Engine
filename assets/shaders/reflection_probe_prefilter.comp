#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform samplerCube sourceRadiance;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray outputMip;
layout(push_constant) uniform PrefilterPush {
    uint outputSize;
    uint sampleCount;
    uint mipLevel;
    uint mipCount;
} push;

const float PI = 3.14159265358979323846;

vec3 cubeDirection(uint face, vec2 uv) {
    float u = uv.x;
    float v = uv.y;
    if (face == 0u) return normalize(vec3(1.0, -v, -u));
    if (face == 1u) return normalize(vec3(-1.0, -v, u));
    if (face == 2u) return normalize(vec3(u, 1.0, v));
    if (face == 3u) return normalize(vec3(u, -1.0, -v));
    if (face == 4u) return normalize(vec3(u, -v, 1.0));
    return normalize(vec3(-u, -v, -1.0));
}

float radicalInverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) |
        ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) |
        ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) |
        ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) |
        ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec3 importanceSampleGgx(vec2 xi, vec3 normal, float roughness) {
    float alpha = max(roughness * roughness, 0.001);
    float alpha2 = alpha * alpha;
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) /
        (1.0 + (alpha2 - 1.0) * xi.y));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 local = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(normal.z) < 0.999
        ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * local.x + bitangent * local.y +
        normal * local.z);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= push.outputSize || id.y >= push.outputSize || id.z >= 6u)
        return;
    vec2 uv = (vec2(id.xy) + 0.5) / float(push.outputSize) * 2.0 - 1.0;
    vec3 normal = cubeDirection(id.z, uv);
    float roughness = push.mipCount > 1u
        ? float(push.mipLevel) / float(push.mipCount - 1u) : 0.0;
    if (push.mipLevel == 0u) {
        imageStore(outputMip, ivec3(id), vec4(
            textureLod(sourceRadiance, normal, 0.0).rgb, 1.0));
        return;
    }
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (uint index = 0u; index < push.sampleCount; ++index) {
        vec2 xi = vec2(float(index) / float(push.sampleCount),
            radicalInverse(index));
        vec3 halfVector = importanceSampleGgx(xi, normal, roughness);
        vec3 light = normalize(2.0 * dot(normal, halfVector) *
            halfVector - normal);
        float noL = max(dot(normal, light), 0.0);
        if (noL > 0.0) {
            sum += textureLod(sourceRadiance, light, 0.0).rgb * noL;
            weight += noL;
        }
    }
    imageStore(outputMip, ivec3(id), vec4(
        sum / max(weight, 0.00001), 1.0));
}
