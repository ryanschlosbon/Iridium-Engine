#version 450

// M9.2 native temporal anti-aliasing (1:1, DLAA-class).
//
// Inputs (scene-linear ACEScg/AP1, jittered by ubo.jitter): this frame's scene
// colour, its depth and per-pixel motion (current minus previous unjittered
// UV). Output: the resolved scene-linear colour, which is next frame's
// history. Every neighbourhood and blend operation runs in a pre-exposed,
// luma-compressed space (c * E / (1 + luma(c * E))), so HDR extremes do not
// dominate the clip box or the blend; the stored history stays scene-linear.
//
// 1. Reconstruct the current colour at the unjittered pixel centre from the
//    3x3 jittered neighbourhood (Blackman-Harris weights).
// 2. Neighbourhood statistics in YCoCg: variance clip box, intersected with the
//    min/max box.
// 3. Motion from the closest-depth neighbour (3x3 dilation); background pixels
//    (no geometry) reproject with the camera matrices.
// 4. History with a 5-tap Catmull-Rom filter, clipped to the box.
// 5. Blend: history weight from luma similarity (anti-flicker) and motion.
// 6. Reactive (M9.3): transparency writes no velocity or depth, so a moving
//    transparent surface over still background looks like a still pixel. The
//    scene colour's alpha holds the revealage of everything blended over the
//    opaque scene (opaque 1; each sorted, glass, layered or WeightedOIT layer
//    multiplies it by 1 - its coverage), so reactive = 1 - alpha, dilated over
//    the 3x3 neighbourhood. Reactive pixels lose the still-pixel trust (wide
//    box, still weight) and reject history on a luma difference against the
//    unclipped history; pixels whose coverage changed have their history
//    weight capped. A static transparent surface over static content keeps
//    accumulating. History alpha remembers last frame's reactive (as a
//    negative value), so the pixels a transparent surface has just left are
//    treated as reactive once.

#include "include/view_uniforms.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D currentColor;   // point
layout(set = 1, binding = 1) uniform sampler2D sceneDepth;     // point
layout(set = 1, binding = 2) uniform sampler2D motionVectors;  // point
layout(set = 1, binding = 3) uniform sampler2D historyColor;   // linear, clamp
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D resolvedColor;
// M9.5: the previous frame's adapted exposure (y: the output multiplier).
layout(set = 1, binding = 5, std430) readonly buffer ExposureState {
    vec4 exposureState;
};

layout(push_constant) uniform TaaPushConstants {
    vec4 extent;       // xy size, zw 1 / size
    vec4 exposure;     // x current pre-exposure, y history pre-exposure, z history valid, w flags (bit 0: pre-expose with exposureState)
    vec4 feedback;     // x minimum history weight, y maximum, z motion pixels for minimum, w variance gamma
    vec4 tuning;       // x reconstruction sharpness, y still-pixel gamma, z still-pixel history weight, w reactive history weight
} push;

const vec3 Ap1Luma = vec3(0.2722287, 0.6740818, 0.0536895);
const float NoHistoryMotion = 3.5;   // include/motion_vectors.glsl reports 4.0
// Reactive (M9.3): coverage above 1/4 is fully reactive; reactive pixels
// reject history 3x as readily on a luma difference.
const float ReactiveScale = 4.0;
const float ReactiveDifferenceScale = 3.0;

shared vec3 tileColor[10][10];   // compressed YCoCg
shared float tileDepth[10][10];
shared float tileReactive[10][10];

float luma(vec3 c) { return dot(c, Ap1Luma); }

vec3 compress(vec3 linear, float exposure) {
    vec3 c = max(linear, vec3(0.0)) * exposure;
    return c / (1.0 + luma(c));
}

vec3 decompress(vec3 compressed, float exposure) {
    float l = min(luma(compressed), 0.999);
    return compressed / ((1.0 - l) * exposure);
}

vec3 toYCoCg(vec3 c) {
    return vec3(dot(c, vec3(0.25, 0.5, 0.25)),
        dot(c, vec3(0.5, 0.0, -0.5)),
        dot(c, vec3(-0.25, 0.5, -0.25)));
}

vec3 fromYCoCg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

ivec2 clampPixel(ivec2 p) {
    return clamp(p, ivec2(0), ivec2(push.extent.xy) - 1);
}

// 5-tap Catmull-Rom (bilinear-folded) history sample, linear space.
vec3 sampleHistory(vec2 uv) {
    vec2 position = uv * push.extent.xy;
    vec2 center = floor(position - 0.5) + 0.5;
    vec2 f = position - center;
    vec2 f2 = f * f;
    vec2 f3 = f2 * f;
    vec2 w0 = -0.5 * f3 + f2 - 0.5 * f;
    vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    vec2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    vec2 w3 = 0.5 * f3 - 0.5 * f2;
    vec2 w12 = w1 + w2;
    vec2 tc12 = (center + w2 / w12) * push.extent.zw;
    vec2 tc0 = (center - 1.0) * push.extent.zw;
    vec2 tc3 = (center + 2.0) * push.extent.zw;
    float wA = w12.x * w0.y;
    float wB = w0.x * w12.y;
    float wC = w12.x * w12.y;
    float wD = w3.x * w12.y;
    float wE = w12.x * w3.y;
    vec3 color =
        textureLod(historyColor, vec2(tc12.x, tc0.y), 0.0).rgb * wA +
        textureLod(historyColor, vec2(tc0.x, tc12.y), 0.0).rgb * wB +
        textureLod(historyColor, tc12, 0.0).rgb * wC +
        textureLod(historyColor, vec2(tc3.x, tc12.y), 0.0).rgb * wD +
        textureLod(historyColor, vec2(tc12.x, tc3.y), 0.0).rgb * wE;
    return max(color / (wA + wB + wC + wD + wE), vec3(0.0));
}

// Clip `history` toward the box centre so it lies inside [boxMin, boxMax].
vec3 clipToBox(vec3 history, vec3 boxMin, vec3 boxMax) {
    vec3 center = 0.5 * (boxMax + boxMin);
    vec3 extents = 0.5 * (boxMax - boxMin) + 1.0e-6;
    vec3 offset = history - center;
    vec3 ratio = abs(offset / extents);
    float scale = max(ratio.x, max(ratio.y, ratio.z));
    return scale > 1.0 ? center + offset / scale : history;
}

void main() {
    ivec2 group = ivec2(gl_WorkGroupID.xy) * 8;
    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    bool exposureFromState = (uint(push.exposure.w) & 1u) != 0u;
    float exposure = exposureFromState ? exposureState.y : push.exposure.x;
    float historyExposure = exposureFromState ? exposureState.y : push.exposure.y;

    // Load the 10x10 tile (8x8 plus a one-pixel border).
    for (int index = int(gl_LocalInvocationIndex); index < 100; index += 64) {
        ivec2 t = ivec2(index % 10, index / 10);
        ivec2 p = clampPixel(group + t - 1);
        vec4 sceneSample = texelFetch(currentColor, p, 0);
        tileColor[t.y][t.x] = toYCoCg(compress(sceneSample.rgb, exposure));
        // Reactive: 1 - the revealage in alpha (NaN reads as opaque).
        float revealage = isnan(sceneSample.a) ? 1.0 : sceneSample.a;
        tileReactive[t.y][t.x] = 1.0 - clamp(revealage, 0.0, 1.0);
        tileDepth[t.y][t.x] = texelFetch(sceneDepth, p, 0).r;
    }
    barrier();

    ivec2 pixel = group + local;
    if (any(greaterThanEqual(pixel, ivec2(push.extent.xy)))) return;
    vec2 uv = (vec2(pixel) + 0.5) * push.extent.zw;

    // Where this frame's samples lie relative to the pixel centres.
    vec2 jitterPixels = ubo.jitter.xy * push.extent.xy * 0.5;

    vec3 filtered = vec3(0.0);
    float filterWeight = 0.0;
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 boxMin = vec3(1.0e9);
    vec3 boxMax = vec3(-1.0e9);
    float closestDepth = 2.0;
    ivec2 closestOffset = ivec2(0);
    float reactive = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 t = local + 1 + ivec2(x, y);
            vec3 c = tileColor[t.y][t.x];
            vec2 d = vec2(x, y) - jitterPixels;
            float w = exp(-push.tuning.x * dot(d, d));
            filtered += c * w;
            filterWeight += w;
            m1 += c;
            m2 += c * c;
            boxMin = min(boxMin, c);
            boxMax = max(boxMax, c);
            reactive = max(reactive, tileReactive[t.y][t.x]);
            float depth = tileDepth[t.y][t.x];
            if (depth < closestDepth) {
                closestDepth = depth;
                closestOffset = ivec2(x, y);
            }
        }
    }
    filtered /= max(filterWeight, 1.0e-6);
    reactive = min(reactive * ReactiveScale, 1.0);
    m1 *= 1.0 / 9.0;
    m2 *= 1.0 / 9.0;
    vec3 sigma = sqrt(max(m2 - m1 * m1, vec3(0.0)));

    // Motion of the closest surface in the neighbourhood.
    vec2 motion;
    if (closestDepth >= 1.0) {
        // No geometry: camera-only reprojection of the far-plane point.
        vec4 view = ubo.inverseProjection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
        vec4 world = ubo.inverseView * (view / view.w);
        vec4 previous = ubo.previousViewProjection * world;
        motion = previous.w > 0.0
            ? uv - (previous.xy / previous.w * 0.5 + 0.5) : vec2(NoHistoryMotion + 1.0);
    }
    else {
        motion = texelFetch(motionVectors, clampPixel(pixel + closestOffset), 0).xy;
    }
    vec2 previousUv = uv - motion;
    bool historyAvailable = push.exposure.z > 0.5 &&
        all(lessThan(abs(motion), vec2(NoHistoryMotion))) &&
        all(greaterThanEqual(previousUv, vec2(0.0))) &&
        all(lessThanEqual(previousUv, vec2(1.0)));

    // Variance box, kept inside the neighbourhood's min/max box. Still pixels
    // reproject exactly onto their own history, so their box may be wider
    // (sub-pixel detail that appears in only some jitter phases survives);
    // moving pixels use the tight box.
    float movedPixels = length(motion * push.extent.xy);
    // Disocclusion: history alpha holds the motion (pixels) of the content
    // that wrote it. A static background just uncovered by a moving occluder
    // has zero motion of its own, but its history moved; such pixels are
    // treated as moving (tight box, fresh weight), not as still ones.
    // A negative history alpha is last frame's reactive instead (its motion
    // is not compared: the pixel is reactive this frame either way).
    float historyReactive = 0.0;
    if (historyAvailable) {
        float historyAlpha = texelFetch(historyColor,
            clampPixel(ivec2(previousUv * push.extent.xy)), 0).a;
        if (historyAlpha < 0.0)
            historyReactive = min(-historyAlpha, 1.0);
        else
            movedPixels = max(movedPixels, abs(historyAlpha - movedPixels));
    }
    // Covered now or last frame: no still-pixel trust. Coverage that changed
    // (a transparent edge arrived or left): history capped.
    float effectiveReactive = max(reactive, historyReactive);
    float reactiveChange = abs(reactive - historyReactive);
    // Still-pixel trust. Jittered sub-pixel detail keeps the history near the
    // luma range its 3x3 neighbourhood spans (a coverage-weighted mix of it); a
    // real change on static geometry (a moving shadow, a light switching) puts
    // the history far outside that range. Only the former keeps the wide box
    // and the high still weight.
    vec3 historySample = vec3(0.0);
    float stillness = (1.0 - clamp(movedPixels, 0.0, 1.0)) * (1.0 - effectiveReactive);
    if (historyAvailable) {
        historySample = toYCoCg(compress(sampleHistory(previousUv), historyExposure));
        float outside = max(max(boxMin.x - historySample.x, historySample.x - boxMax.x), 0.0);
        float relative = outside / max(max(historySample.x, boxMax.x), 0.05);
        stillness *= 1.0 - smoothstep(0.1, 0.3, relative);
    }
    float gamma = mix(push.feedback.w, push.tuning.y, stillness);
    vec3 clipMin = max(boxMin, m1 - gamma * sigma);
    vec3 clipMax = min(boxMax, m1 + gamma * sigma);
    if (push.tuning.y > push.feedback.w) {
        // A widened still-pixel box may exceed the neighbourhood min/max.
        clipMin = mix(clipMin, m1 - gamma * sigma, stillness);
        clipMax = mix(clipMax, m1 + gamma * sigma, stillness);
    }

    vec3 resolved = filtered;
    if (historyAvailable) {
        vec3 history = clipToBox(historySample, clipMin, clipMax);
        // Moving content: similar lumas keep more history (Lottes), so a
        // changed surface refreshes quickly.
        float lumaCurrent = filtered.x;
        float lumaHistory = history.x;
        float difference = abs(lumaCurrent - lumaHistory) /
            max(max(lumaCurrent, lumaHistory), 0.2);
        float similarity = (1.0 - difference) * (1.0 - difference);
        float historyWeight = mix(push.feedback.x, push.feedback.y, similarity);
        // Reactive pixels: the transparent layer's own motion is unknown, so
        // the comparison uses the history before clipping (the clip box can
        // span a moving pattern), rejects 3x as readily and may fall to the
        // reactive weight. Static transparency over static content matches
        // its history and keeps accumulating. (Non-reactive pixels keep the
        // rule above bit for bit.)
        if (effectiveReactive > 0.0) {
            lumaHistory = mix(history.x, historySample.x, effectiveReactive);
            difference = abs(lumaCurrent - lumaHistory) /
                max(max(lumaCurrent, lumaHistory), 0.2);
            difference = min(difference *
                mix(1.0, ReactiveDifferenceScale, effectiveReactive), 1.0);
            similarity = (1.0 - difference) * (1.0 - difference);
            historyWeight = mix(mix(push.feedback.x, push.tuning.w, effectiveReactive),
                push.feedback.y, similarity);
        }
        // Still pixels: the jittered samples of sub-pixel detail differ every
        // frame by design, so luma difference is not a reason to refresh;
        // a fixed high weight integrates them instead of letting them flicker
        // (the clip box still rejects real changes).
        if (push.tuning.z > 0.0)
            historyWeight = mix(historyWeight, push.tuning.z, stillness);
        // Motion: fresh samples matter more for moving content.
        historyWeight = mix(historyWeight, push.feedback.x,
            clamp(movedPixels / max(push.feedback.z, 1.0e-3), 0.0, 1.0));
        // Changed coverage: capped toward the reactive weight.
        if (reactiveChange > 0.0)
            historyWeight = mix(historyWeight, min(historyWeight, push.tuning.w),
                reactiveChange);
        resolved = mix(filtered, history, historyWeight);
    }

    vec3 linear = decompress(fromYCoCg(resolved), exposure);
    if (any(isnan(linear)) || any(isinf(linear)))
        linear = max(texelFetch(currentColor, pixel, 0).rgb, vec3(0.0));
    // Alpha: this pixel's motion in pixels (the next frame's disocclusion
    // test), or minus its reactive where transparency covers it. No consumer
    // reads the resolved alpha.
    float historyTag = reactive > (1.0 / 256.0)
        ? -reactive : min(length(motion * push.extent.xy), 1024.0);
    imageStore(resolvedColor, pixel, vec4(linear, historyTag));
}
